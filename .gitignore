# Upstream clones. Fetched by scripts/sync.sh, never edited, never committed.
# This is also what keeps the copyleft upstreams out of what this repo distributes.
upstream/

# Generated by scripts/build.py from upstream/ + curation.json. Rebuilt from scratch
# every run, so nothing here is worth keeping.
build/

# Which forked-plugin fingerprints were last installed. Machine-local.
.install-state.json

# Raw eval transcripts. The scored summaries under eval/results/ are committed.
eval/results/raw/

# The eval fixture is a repo the harness commits into at runtime.
eval/fixture/.git

.DS_Store
